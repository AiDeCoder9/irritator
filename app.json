{
  "expo": {
    "name": "IRRITATOR",
    "slug": "irritator",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.irritator.app"
    },
    "android": {
      "package": "com.irritator.app",
      "adaptiveIcon": {
        "backgroundColor": "#F2B33D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "react-native-notify-kit",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "IRRITATOR checks that you are at your gym when you tap I'm at the gym."
        }
      ],
      "./plugins/withLockScreen"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7540cf6c-08cf-4688-92ce-fe09f54bb5a5",
      "requestHeaders": {
        "expo-channel-name": "main"
      }
    },
    "extra": {
      "eas": {
        "projectId": "7540cf6c-08cf-4688-92ce-fe09f54bb5a5"
      }
    }
  }
}